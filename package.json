{
  "name": "perinihub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "db:push": "set -a && . ./.env.local && set +a && npx -y supabase@2.122.0 db push --db-url \"$SUPABASE_DB_URL\"",
    "db:types": "set -a && . ./.env.local && set +a && npx -y supabase@2.122.0 gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/lib/supabase/database.types.ts",
    "db:sales:push": "set -a && . ./.env.local && set +a && npx -y supabase@2.122.0 db push --workdir supabase-sales --db-url \"$SALES_SUPABASE_DB_URL\"",
    "db:sales:types": "set -a && . ./.env.local && set +a && { echo \"// Gerado por \\`npm run db:sales:types\\` (supabase gen types, projeto AI Sales). Não editar à mão.\"; npx -y supabase@2.122.0 gen types typescript --db-url \"$SALES_SUPABASE_DB_URL\" --schema public; } > src/lib/supabase/sales.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:sales": "vitest run --config vitest.integration.config.mts src/features/ai-sales"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@trigger.dev/sdk": "^4.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "lucide-react": "^1.17.0",
    "next": "^16.4.3",
    "node-html-parser": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trigger.dev/build": "^4.8.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.2",
    "shadcn": "4.8.3",
    "tailwindcss": "^4",
    "trigger.dev": "^4.8.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
