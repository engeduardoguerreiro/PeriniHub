# PeriniHub Tech — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) e preencha. Nunca versionar valores reais.
# Onde cada valor é usado: [next] = app na Vercel, [worker] = tarefas no Trigger.dev.

# --- Supabase --------------------------------------------------------------
# Project URL (Dashboard > Connect, ou Project Settings > Data API). [next][worker]
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Pública por natureza; o acesso é limitado pelo RLS. [next][worker]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Ignora o RLS: SÓ no servidor/worker, nunca com prefixo NEXT_PUBLIC. [worker]
SUPABASE_SECRET_KEY=
# Connection string do Postgres (Session pooler), usada só localmente para aplicar migrations.
SUPABASE_DB_URL=

# --- Trigger.dev -----------------------------------------------------------
# Referência do projeto (proj_...), em Project settings. Não é segredo. [next][worker]
TRIGGER_PROJECT_REF=
# Secret key do ambiente (tr_dev_... local, tr_prod_... produção). Permite disparar tarefas. [next]
TRIGGER_SECRET_KEY=

# --- IA (Anthropic) --------------------------------------------------------
# Chave da API (sk-ant-...). Usada só pelos agentes no worker. [worker]
ANTHROPIC_API_KEY=
# Teto mensal de gasto com IA, em dólares. O pipeline para antes de ultrapassá-lo. [worker]
NEWS_MONTHLY_COST_LIMIT_USD=5

# --- Integração worker -> site --------------------------------------------
# URL do site que o worker chama para invalidar o cache após publicar. [worker]
NEWS_SITE_URL=http://localhost:3000
# Segredo compartilhado (HMAC) entre worker e site. Gere com: openssl rand -hex 32. [next][worker]
NEWS_REVALIDATE_SECRET=

# --- PeriniHub AI Sales (projeto Supabase próprio, "AI Sales") -------------
# Liga o módulo. Ausente/false: /ai-sales responde 404 e nada do produto roda. [next]
AI_SALES_ENABLED=false
# Exige segundo fator (AAL2) no painel de plataforma. Desligado por ora (decisão D-16). [next]
AI_SALES_PLATFORM_REQUIRE_MFA=false
# Project URL e publishable key do projeto "AI Sales" (não confundir com o portal). [next]
NEXT_PUBLIC_SALES_SUPABASE_URL=
NEXT_PUBLIC_SALES_SUPABASE_PUBLISHABLE_KEY=
# Secret key do projeto "AI Sales". Ignora o RLS: SÓ no servidor, nunca com NEXT_PUBLIC. [next]
SALES_SUPABASE_SECRET_KEY=
# Connection string (Session pooler) do "AI Sales", só local: npm run db:sales:push / db:sales:types.
SALES_SUPABASE_DB_URL=
# Sal do hash de IP usado no limite de tentativas (openssl rand -hex 16). Opcional. [next]
AI_SALES_IP_HASH_SALT=
# WhatsApp (Cloud API oficial). "mock" libera o modo simulado; em produção use "live". [next]
WHATSAPP_MODE=mock
# Versão fixa da Graph API (conferida em 2026-10-30). [next]
WHATSAPP_GRAPH_API_VERSION=v26.0
# App Secret do app da Meta (Configurações > Básico): valida a assinatura dos webhooks. [next]
WHATSAPP_APP_SECRET=
# Token que a Meta envia na verificação do webhook. Gere com: openssl rand -hex 24 [next]
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
